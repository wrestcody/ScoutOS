# ScoutOS Hub Local Environment Variables
# Copy this file to `.env` and fill in your details before running `./boot.sh` (if bypassing SOPS).

# ==========================================
# LOCAL VECTOR STORE & RAG
# ==========================================
# The absolute path to your Obsidian vault. ScoutOS will automatically index
# and write to the `00_Inbox/Argus_Sync/` directory within this path.
OBSIDIAN_VAULT_PATH=/Users/yourusername/Documents/Obsidian/MyPARA_Vault

# ==========================================
# SECURITY TOGGLES & LLM ROUTING
# ==========================================
# VITE_AI_MODE controls the Air-Gap protocol.
#   - 'local' : Blocks external API polling. Blocks Atlassian MCP. Uses local Ollama.
#   - 'cloud' : Enables Genesys/Graph API polling. Enables MCP. Uses OpenAI (gpt-4-turbo).
VITE_AI_MODE=local

# Required ONLY if VITE_AI_MODE=cloud. Ensure your API key has access to gpt-4-turbo.
OPENAI_API_KEY=sk-proj-your_openai_api_key

# ==========================================
# ENTERPRISE INTEGRATIONS (API KEYS)
# Note: These are only accessed if VITE_AI_MODE=cloud.
# ==========================================

# 1. Genesys Cloud (Vanguard Module)
# Create an OAuth Client in Genesys Cloud with "Client Credentials" grant type.
# Requires permissions: `conversation:message:view`
GENESYS_CLIENT_ID=your_genesys_client_id
GENESYS_CLIENT_SECRET=your_genesys_client_secret

# 2. Microsoft Graph / Outlook (Vanguard Module)
# Register an app in Azure AD. Grant Application permission `Mail.Read`.
MS_GRAPH_TENANT_ID=your_azure_tenant_id
MS_GRAPH_CLIENT_ID=your_ms_graph_client_id
MS_GRAPH_CLIENT_SECRET=your_ms_graph_client_secret

# 3. Atlassian / Confluence (Argus / MCP Module)
# Generate an API token from your Atlassian Account settings.
ATLASSIAN_DOMAIN=your_company.atlassian.net
ATLASSIAN_EMAIL=your_email@domain.com
ATLASSIAN_API_TOKEN=your_atlassian_api_token
# The ID of the specific Confluence space where ScoutOS should scaffold Architecture (HLA) documents.
ATLASSIAN_SPACE_ID=your_confluence_space_id
