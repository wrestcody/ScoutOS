terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# Scaffold only: define IAM roles, Lambda functions, Secrets, API Gateway, EventBridge in subsequent edits.

