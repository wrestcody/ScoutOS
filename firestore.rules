rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /audit_logs/{logId} {
      // Use resource.data check to satisfy the "Secure List Queries" pillar
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /scrs/{scrId} {
      allow list: if request.auth != null && resource.data.creatorId == request.auth.uid;
      allow get: if request.auth != null && resource.data.creatorId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null && resource.data.creatorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;

      match /logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
